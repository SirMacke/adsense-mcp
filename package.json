{
  "name": "@sirmacke/adsense-mcp",
  "version": "0.2.0",
  "license": "MIT",
  "description": "Read-only MCP server for AdSense accounts, inventory, payments, policy, and reports",
  "mcpName": "io.github.SirMacke/adsense-mcp",
  "type": "module",
  "main": "dist/index.js",
  "bin": { "adsense-mcp": "dist/index.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "repository": { "type": "git", "url": "git+https://github.com/SirMacke/adsense-mcp.git" },
  "bugs": { "url": "https://github.com/SirMacke/adsense-mcp/issues" },
  "homepage": "https://github.com/SirMacke/adsense-mcp#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "npm run check:version && npm run build && tsx --test test/**/*.test.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "package": "node scripts/build-mcpb.mjs",
    "authorize": "node scripts/authorize.mjs",
    "prepack": "npm run build",
    "check:version": "node scripts/check-version.mjs"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
