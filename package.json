{
  "name": "adsense-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for extracting AdSense Management API v2 report data",
  "type": "module",
  "bin": { "adsense-mcp": "dist/index.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/**/*.test.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "package": "node scripts/build-mcpb.mjs"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
